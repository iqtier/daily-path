@baseUrl = http://localhost:5173
@goalId = 8bca05d5-183a-4e3f-b154-74501d7cdc7a
@task1 =63ca16de-2818-4a38-8899-f454e4e7b6f2
@task3 = b65b0810-00df-4d42-9e68-2866decf6d27
@fitGoalId = 288612b4-242f-418e-8181-4360d7ce7776
### Add a goal
POST {{baseUrl}}/api/goals
Content-Type: application/json

{
  "title": "Get fit",
  "details": "Beginner, no gym",
  "category": "fitness",
  "status": "active"
}

### List goals
GET {{baseUrl}}/api/goals

### Edit a goal
PUT {{baseUrl}}/api/goals/{{goalId}}
Content-Type: application/json

{
  "title": "Get fit",
  "details": "Walk 3 times a week",
  "category": "fitness",
  "status": "paused"
}

### Delete a goal
DELETE {{baseUrl}}/api/goals/{{goalId}}

### Should fail: missing title
POST {{baseUrl}}/api/goals
Content-Type: application/json

{
  "category": "fitness",
  "status": "active"
}

### Should fail: goal that does not exist
GET {{baseUrl}}/api/goals/00000000-0000-0000-0000-000000000099


@taskId = 636abda3-1b6a-4d4d-b24e-c463759a9cfd

### Future task: create with size only
POST {{baseUrl}}/api/future-tasks
Content-Type: application/json

{
  "title": "Research report",
  "type": "assignment",
  "dueDate": "2026-10-20",
  "weight": 15,
  "size": "large",
  "materials": "12 pages, 5 sources"
}

### Future task: create with exact hours
POST {{baseUrl}}/api/future-tasks
Content-Type: application/json

{
  "title": "Math midterm",
  "type": "exam",
  "dueDate": "2026-10-15",
  "weight": 25,
  "size": "large",
  "estimatedHours": 8,
  "materials": "Chapters 3 to 6"
}

### Future task: list
GET {{baseUrl}}/api/future-tasks

### Future task: mark done
PUT {{baseUrl}}/api/future-tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Math midterm",
  "type": "exam",
  "dueDate": "2026-10-15",
  "weight": 25,
  "size": "large",
  "estimatedHours": 8,
  "materials": "Chapters 3 to 6",
  "status": "done"
}

### Future task: reopen
PUT {{baseUrl}}/api/future-tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Math midterm",
  "type": "exam",
  "dueDate": "2026-10-15",
  "weight": 25,
  "estimatedHours": 8,
  "status": "pending"
}

### Future task: should fail, weight over 100
POST {{baseUrl}}/api/future-tasks
Content-Type: application/json

{
  "title": "Bad task",
  "type": "other",
  "dueDate": "2026-10-20",
  "weight": 500
}

### Future task: delete
DELETE {{baseUrl}}/api/future-tasks/{{taskId}}

